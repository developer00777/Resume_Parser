# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Text extraction (3 parallel JSON chunks) — fast MoE, ~70% cheaper output than gpt-4o-mini
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OCR fallback for image-based PDFs — must stay multimodal/vision-capable
OPENROUTER_OCR_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Core ─────────────────────────────────────────────────────────────────────
API_KEY=changeme
MAX_FILE_SIZE=10485760
LOG_LEVEL=INFO

# ── Synchronous bulk endpoints ───────────────────────────────────────────────
# Salesforce caps a callout at 120s, so BULK_TIMEOUT must stay under that.
# Hitting the budget now returns 200 with partial results, not 504.
BULK_MAX_FILES=15
BULK_TIMEOUT=110
BULK_CONCURRENCY=5

# ── Redis job queue (async bulk path) ────────────────────────────────────────
# Railway's Redis plugin injects REDIS_URL automatically; compose sets redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=resume_parse
# Files accepted per async batch (no wall-clock limit on this path)
QUEUE_MAX_FILES=100
# Resumes parsed in parallel per worker process — add worker replicas to go wider
WORKER_CONCURRENCY=8
# Per-file budget inside the worker (seconds)
JOB_TIMEOUT=300
# Attempts per file before it is recorded as failed (transient errors only)
JOB_MAX_TRIES=3
# How long uploaded bytes and batch results live in Redis (seconds)
JOB_TTL=86400
# A batch with nothing running and no progress for this long is reaped
JOB_STALE_SECONDS=1800

# ── Optional completion callback ─────────────────────────────────────────────
JOB_CALLBACK_TIMEOUT=30
# Comma-separated host suffixes allowed as callback targets. Empty = allow any.
JOB_CALLBACK_ALLOWED_HOSTS=

# ── Salesforce Connected App credentials ─────────────────────────────────────
# Create a Connected App in Salesforce Setup → App Manager
# Enable OAuth, add scopes: api, refresh_token (or full)
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Only needed for Username-Password OAuth flow (leave blank for client_credentials)
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=          # Append to password for non-trusted IPs

SF_LOGIN_URL=https://login.salesforce.com   # or https://test.salesforce.com for sandbox
SF_API_VERSION=59.0
